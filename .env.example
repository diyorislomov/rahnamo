# Copy to .env.local. Never commit populated credentials.
# Leave BOTH public values empty for an explicitly labeled local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for real submissions and administrator actions.
SUPABASE_SERVICE_ROLE_KEY=
# Use unique random secrets (at least 32 characters recommended).
SESSION_SECRET=
ADMIN_PASSWORD=
# Individual mentor credentials, never one shared code. Each value >=12 characters.
# Example shape only: {"actual-counselor-id":"unique-long-random-credential"}
COUNSELOR_PASSCODES={}
# Manual transfer destination. No card data is collected from students.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
# Optional notifications; a saved booking remains saved if delivery fails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
